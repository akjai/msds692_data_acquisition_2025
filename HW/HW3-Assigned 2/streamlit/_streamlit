# Use continuumio/miniconda3 as a base image 
FROM continuumio/miniconda3

# Set /HW3Assigned 2 as a working directory
WORKDIR /HW3Assigned 2/streamlit

# Copy environment.yml
COPY * .

# create an environment using environment.yml
RUN conda env create -f environment.yml -n hw3_streamlit

# install fastapi[standard] for fastapi's cli on the environment
RUN conda install -n hw3_streamlit -c conda-forge streamlit 

# expose port 8501
EXPOSE 8501

# run the main.py as streamlit app.
CMD ["conda", "run", "--no-capture-output", "-n", "hw3_streamlit", "streamlit", "run", "main.py", "--port=8501", "--host=0.0.0.0"]